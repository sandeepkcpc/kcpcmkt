# DEV deployment environment - /opt/kcpc-dev on the VM.
# Copy to .env on the VM (never commit the real file - see .gitignore). Values here must be
# DIFFERENT from deploy/prod/.env.example's real counterparts - never reuse a DEV secret in PROD
# or vice versa.

# ---- Artifact Registry image -----------------------------------------------------------------
# REQUIRES USER VALUE: REGION and PROJECT_ID from your GCP setup.
AR_IMAGE=REGION-docker.pkg.dev/PROJECT_ID/kcpc/kcpc-app
# Set by deploy/scripts/deploy.sh on every deploy - the git SHA that was actually built and
# pushed. "dev" is a friendly floating tag for manual/local recovery only, never the deploy target.
IMAGE_TAG=dev

# ---- Database (isolated from PROD: separate name, separate volume, separate passwords) --------
DB_NAME=kcpc_dev
MIGRATOR_DB_PASSWORD=changeme-dev-migrator-password
APP_DB_PASSWORD=changeme-dev-app-password

# ---- Application security ----------------------------------------------------------------------
# Generate with: openssl rand -hex 64 - MUST differ from PROD's secret.
APP_SECURITY_JWT_SECRET=changeme-generate-a-real-64-byte-secret-distinct-from-prod
# false until dev.example.com (or equivalent) actually terminates HTTPS in front of this stack.
COOKIE_SECURE=false

# ---- Google Drive folder provisioning (optional) -----------------------------------------------
# Leave DRIVE_ENABLED=false to leave Drive fully inert. If enabling for DEV, DRIVE_SHARED_DRIVE_ID
# / DRIVE_ROOT_FOLDER_ID MUST point at a DEV-only Drive location (e.g. "KCPC DEV CONTENT") -
# NEVER the production root. See deploy/README.md "Google Drive isolation".
DRIVE_ENABLED=false
DRIVE_SERVICE_ACCOUNT_KEY=
DRIVE_SHARED_DRIVE_ID=
DRIVE_ROOT_FOLDER_ID=
DRIVE_IMPERSONATE_USER=
