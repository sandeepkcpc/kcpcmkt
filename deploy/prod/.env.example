# PROD deployment environment - /opt/kcpc-prod on the VM.
# Copy to .env on the VM (never commit the real file - see .gitignore). Values here must be
# DIFFERENT from deploy/dev/.env.example's real counterparts - never reuse a DEV secret in PROD
# or vice versa.

# ---- Artifact Registry image -----------------------------------------------------------------
# REQUIRES USER VALUE: REGION and PROJECT_ID from your GCP setup.
AR_IMAGE=REGION-docker.pkg.dev/PROJECT_ID/kcpc/kcpc-app
# Set by deploy/scripts/deploy.sh on every deploy - the git SHA that was actually built and
# pushed. Compose is deliberately configured to REQUIRE this be set explicitly for PROD (no
# ":prod" fallback default) - every real production deploy must pin an immutable SHA.
IMAGE_TAG=

# ---- Database (isolated from DEV: separate name, separate EXTERNAL volume, separate passwords) -
DB_NAME=kcpc_prod
MIGRATOR_DB_PASSWORD=changeme-prod-migrator-password
APP_DB_PASSWORD=changeme-prod-app-password

# ---- Application security ----------------------------------------------------------------------
# Generate with: openssl rand -hex 64 - MUST differ from DEV's secret.
APP_SECURITY_JWT_SECRET=changeme-generate-a-real-64-byte-secret-distinct-from-dev
# true once app.example.com (or equivalent) actually terminates HTTPS in front of this stack -
# see nginx.conf's commented HTTPS block. Keep false only for the brief window before TLS exists.
COOKIE_SECURE=true

# ---- Google Drive folder provisioning (optional) -----------------------------------------------
# Leave DRIVE_ENABLED=false to leave Drive fully inert (the safe starting state). If enabling,
# DRIVE_SHARED_DRIVE_ID / DRIVE_ROOT_FOLDER_ID MUST point at the real "KCPC PROD CONTENT" Drive
# location - NEVER the DEV/test root. See deploy/README.md "Google Drive isolation".
DRIVE_ENABLED=false
DRIVE_SERVICE_ACCOUNT_KEY=
DRIVE_SHARED_DRIVE_ID=
DRIVE_ROOT_FOLDER_ID=
DRIVE_IMPERSONATE_USER=
