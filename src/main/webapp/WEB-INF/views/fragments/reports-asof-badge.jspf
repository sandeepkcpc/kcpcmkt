<%-- "Data as of <timestamp>" badge, positioned next to each Reports screen's own H1 (caller sets
     ${reportsDataAsOf}, an Instant, before including this file). --%>
<div class="reports-asof">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 15 14"/></svg>
    Data as of ${kcpc:ist(reportsDataAsOf)}
</div>
