<%-- ENG-076 (defect fix): one Platform chip + its popover for the Content Pipeline dashboard's
     Platforms column. Caller sets ${summary} (a PipelinePlatformSummary) and ${popoverId} (a
     page-unique id) via <c:set> immediately before including this file. The chip is ALWAYS
     clickable - opening a popover listing every real publishing task's status - regardless of
     whether anything on this platform has been published yet; the popover is for viewing task
     status, not just for opening live links, so a fully-pending platform (0 published) must be
     just as clickable as a fully/partially published one. The "active" (any published) vs "muted"
     (all pending) chip classes are kept as a purely cosmetic color cue only - both are real
     <button> elements wired to the exact same popover-toggle behavior. Icon + count only in the
     chip itself (no platform-name text) - the name is still exposed via title/aria-label for
     accessibility, and shown in full in the popover header. The popover itself is moved to a
     <body>-level fixed-position overlay by pipeline-dashboard.js on open (never rendered/clipped
     inline in the scrollable table), so its markup here is just the template.

     Icons are local SVG files under /icons/platforms/ (no CDN, no emoji) - see
     src/main/resources/static/icons/platforms/. Any platform not in this list falls back to
     generic.svg; the fallback is cosmetic only, so a new/unseeded platform from the catalogue
     still renders (with a generic icon) rather than being excluded. --%>
<c:choose>
    <c:when test="${summary.platformName == 'Instagram'}"><c:set var="platformIconFile" value="instagram.svg"/></c:when>
    <c:when test="${summary.platformName == 'Facebook'}"><c:set var="platformIconFile" value="facebook.svg"/></c:when>
    <c:when test="${summary.platformName == 'YouTube'}"><c:set var="platformIconFile" value="youtube.svg"/></c:when>
    <c:when test="${summary.platformName == 'Threads'}"><c:set var="platformIconFile" value="threads.svg"/></c:when>
    <c:when test="${summary.platformName == 'Moj'}"><c:set var="platformIconFile" value="moj.svg"/></c:when>
    <c:when test="${summary.platformName == 'TikTok'}"><c:set var="platformIconFile" value="tiktok.svg"/></c:when>
    <c:otherwise><c:set var="platformIconFile" value="generic.svg"/></c:otherwise>
</c:choose>
<c:set var="platformIconSrc" value="${pageContext.request.contextPath}/icons/platforms/${platformIconFile}"/>
<div class="pipeline-platform-chip-wrap">
    <button type="button" class="pipeline-platform-chip ${summary.anyPublished ? 'active' : 'muted'}"
            data-popup-target="${popoverId}" aria-haspopup="true" aria-expanded="false"
            aria-label="${summary.platformName}: ${summary.publishedChannels} of ${summary.totalChannels} published"
            title="${summary.platformName} &middot; ${summary.publishedChannels} / ${summary.totalChannels} published">
        <img class="pipeline-platform-icon" src="${platformIconSrc}" alt="" width="18" height="18"/>
        <span class="pipeline-platform-count">&times;${summary.totalChannels}</span>
    </button>
    <div class="pipeline-platform-popover hidden" id="${popoverId}" role="dialog" aria-label="${summary.platformName} publication status">
        <div class="pipeline-platform-popover-header">
            <img class="pipeline-platform-icon" src="${platformIconSrc}" alt="" width="18" height="18"/>
            <span class="pipeline-platform-popover-title"><c:out value="${summary.platformName}"/> (${summary.totalChannels})</span>
            <span class="pipeline-platform-progress">${summary.publishedChannels}/${summary.totalChannels} published</span>
        </div>
        <%-- ENG-076 (defect fix): one row per real (Planned Output, Publication Target) publishing
             task - never grouped/deduplicated by channel, since the same channel is legitimately
             the target of more than one Planned Output (e.g. Photography/Video/Reel outputs all
             publishing to the same page). No Output column - Type + Channel are enough to tell
             rows apart here; the Planned Output's own title is shown elsewhere (Planning tab). --%>
        <table class="pipeline-platform-popover-table">
            <thead>
                <tr>
                    <th>Type</th><th>Channel</th><th>Status</th><th>Link</th>
                </tr>
            </thead>
            <tbody>
                <c:forEach var="ch" items="${summary.channels}">
                    <tr class="pipeline-channel-row ${ch.published ? 'published' : 'pending'}">
                        <td class="pipeline-channel-type"><c:out value="${ch.typeLabel}"/></td>
                        <td class="pipeline-channel-handle">@<c:out value="${ch.channelHandle}"/></td>
                        <c:choose>
                            <c:when test="${ch.published}">
                                <td class="pipeline-channel-status">Published</td>
                                <td><a class="pipeline-channel-open" href="${ch.evidenceUrl}" target="_blank" rel="noopener noreferrer">Open &#8599;</a></td>
                            </c:when>
                            <c:otherwise>
                                <td class="pipeline-channel-status muted">Pending</td>
                                <td class="pipeline-channel-status muted">-</td>
                            </c:otherwise>
                        </c:choose>
                    </tr>
                </c:forEach>
            </tbody>
        </table>
    </div>
</div>
