<%-- ENG-071: one Planned/Actual date-range filter column header - each of the 6 date columns gets
     its OWN independent range (replacing ENG-070's single combined Planned/Actual range). Caller
     sets via <c:set> immediately before including:
       filterField   - query param PREFIX (e.g. "plannedShoot" -> plannedShootFrom/plannedShootTo)
       filterLabel   - visible header text
       filterFrom    - current From value (LocalDate or empty)
       filterTo      - current To value
       filterActive  - true if this column currently has a range applied
       filterSortField - sortBy value for this column (date columns are always sortable) --%>
<div class="pipeline-th-flex">
    <c:set var="sortField" value="${filterSortField}"/><c:set var="sortLabel" value="${filterLabel}"/>
    <%@ include file="pipeline-sort-header.jspf" %>
    <button type="button" class="pipeline-filter-trigger ${filterActive ? 'active' : ''}" data-popup-target="popup-${filterField}" aria-label="Filter ${filterLabel}">&#9660;</button>
</div>
<div class="pipeline-filter-popup hidden" id="popup-${filterField}">
    <label>From <input type="date" name="${filterField}From" value="${filterFrom}"></label>
    <label>To <input type="date" name="${filterField}To" value="${filterTo}"></label>
    <div class="pipeline-filter-popup-actions">
        <button type="button" class="btn-outline pipeline-filter-clear">Clear</button>
        <button type="submit" class="btn-outline">Apply</button>
    </div>
</div>
