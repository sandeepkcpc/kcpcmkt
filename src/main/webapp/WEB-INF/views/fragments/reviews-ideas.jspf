<%-- Manager Reviews Workspace - Ideas tab. Caller (ReviewsMvcController#buildIdeasTab) sets
     ${queueRows} (List<IdeaQueueRow>), ${ideaView} ("pending" or "retained"), ${ideasRetainedCount},
     ${q}/${dateFrom}/${dateTo}/${sort}, pagination attrs
     (${totalCount}/${currentPage}/${totalPages}/${fromIndex}/${toIndex}/${pageSize}), ${selectedId},
     and - when an item is selected - ${selectedIdea}/${ideaStatusLabel}/${ideaStatusCssClass}/
     ${ideaStatusHistory}/${canDecideSelected}. Idea status here is ALWAYS the Idea-only vocabulary
     (Under Review/Reopened/Retained) - this queue only ever contains PA-status ideas (pending view)
     or RET-status ideas (retained view), never a downstream Content status.

     Retained sub-view: a RETAIN decision moves the idea to workflow status RET (dormant), out of
     the pending queue entirely - with the old company-wide Idea Queue screen gone from CEO/MM nav,
     this toggle is now the only place to find/reopen a retained idea. Every URL below carries
     ${ideaView} through exactly like ${tab}=ideas already is, so switching sub-views, searching,
     paging, and sorting all stay on the same sub-view instead of silently bouncing back to Pending. --%>
<div class="reviews-body">
    <div class="reviews-queue">
        <div class="reviews-idea-subtabs">
            <a class="reviews-tab reviews-idea-subtab ${ideaView == 'retained' ? '' : 'active'}"
               href="${pageContext.request.contextPath}/app/reviews?tab=ideas">
                Pending Reviews <span class="count-badge">${ideasPendingCount}</span>
            </a>
            <a class="reviews-tab reviews-idea-subtab ${ideaView == 'retained' ? 'active' : ''}"
               href="${pageContext.request.contextPath}/app/reviews?tab=ideas&amp;ideaView=retained">
                Retained <span class="count-badge">${ideasRetainedCount}</span>
            </a>
        </div>

        <form method="get" action="${pageContext.request.contextPath}/app/reviews" class="reviews-filters" id="reviewsFilterForm">
            <input type="hidden" name="tab" value="ideas">
            <input type="hidden" name="ideaView" value="${ideaView}">
            <input type="hidden" name="sort" value="${sort}">
            <div class="filter-field filter-field-search">
                <label for="rvIdeaSearch">Search</label>
                <input type="text" name="q" id="rvIdeaSearch" placeholder="Search by Idea ID or title..." value="${fn:escapeXml(q)}">
            </div>
            <div class="filter-field">
                <label for="rvIdeaDateFrom">Submitted</label>
                <div class="filter-date-range">
                    <input type="date" name="dateFrom" id="rvIdeaDateFrom" value="${dateFrom}">
                    <span class="filter-date-sep">&ndash;</span>
                    <input type="date" name="dateTo" id="rvIdeaDateTo" value="${dateTo}">
                </div>
            </div>
            <a class="btn-outline reviews-clear" href="${pageContext.request.contextPath}/app/reviews?tab=ideas&amp;ideaView=${ideaView}">
                <span aria-hidden="true">&#8635;</span> Clear
            </a>
        </form>

        <div class="panel reviews-table-panel">
            <h2 class="reviews-queue-title">${ideaView == 'retained' ? 'Retained Ideas' : 'Pending Idea Reviews'}</h2>
            <div class="reviews-table-scroll">
            <table class="data-table reviews-table">
                <thead>
                <tr>
                    <th>Idea ID</th>
                    <th>Idea</th>
                    <th>Submitted By</th>
                    <th>
                        <c:url var="rvSortUrl" value="/app/reviews">
                            <c:param name="tab" value="ideas"/><c:param name="ideaView" value="${ideaView}"/><c:param name="q" value="${q}"/>
                            <c:param name="dateFrom" value="${dateFrom}"/><c:param name="dateTo" value="${dateTo}"/>
                            <c:param name="pageSize" value="${pageSize}"/>
                            <c:param name="sort" value="${sort == 'DATE_ASC' ? 'DATE_DESC' : 'DATE_ASC'}"/>
                        </c:url>
                        <a class="reviews-sort-link" href="${rvSortUrl}">Submitted On <span class="sort-icon">&#8693;</span></a>
                    </th>
                    <th>Action</th>
                </tr>
                </thead>
                <tbody>
                <c:forEach var="row" items="${queueRows}">
                    <c:url var="rvRowUrl" value="/app/reviews">
                        <c:param name="tab" value="ideas"/><c:param name="ideaView" value="${ideaView}"/><c:param name="q" value="${q}"/>
                        <c:param name="dateFrom" value="${dateFrom}"/><c:param name="dateTo" value="${dateTo}"/>
                        <c:param name="sort" value="${sort}"/><c:param name="pageSize" value="${pageSize}"/>
                        <c:param name="page" value="${currentPage}"/><c:param name="selectedId" value="${row.ideaId}"/>
                    </c:url>
                    <tr class="reviews-row ${row.ideaId == selectedId ? 'reviews-row-active' : ''}" data-row-url="${rvRowUrl}">
                        <td><a class="idea-id-link reviews-row-link" href="${rvRowUrl}"><c:out value="${row.businessIdeaCode}"/></a></td>
                        <td class="idea-queue-title-cell" title="${fn:escapeXml(row.title)}"><c:out value="${row.title}"/></td>
                        <td><c:out value="${row.submittedByName}"/></td>
                        <td>${kcpc:ist(row.submittedAt)}</td>
                        <td><a class="btn-outline reviews-row-link reviews-view-btn" href="${rvRowUrl}" title="View">&#128065;</a></td>
                    </tr>
                </c:forEach>
                <c:if test="${empty queueRows}">
                    <tr><td colspan="5" class="muted">${ideaView == 'retained' ? 'No ideas are currently retained.' : 'No ideas are currently pending review.'}</td></tr>
                </c:if>
                </tbody>
            </table>
            </div>

            <div class="pagination reviews-pagination">
                <span>Showing ${fromIndex} to ${toIndex} of ${totalCount}</span>
                <div class="reviews-page-size">
                    <select id="rvIdeaPageSize" name="pageSize" form="reviewsFilterForm">
                        <option value="10" ${pageSize == 10 ? 'selected' : ''}>10 per page</option>
                        <option value="25" ${pageSize == 25 ? 'selected' : ''}>25 per page</option>
                        <option value="50" ${pageSize == 50 ? 'selected' : ''}>50 per page</option>
                    </select>
                </div>
                <div class="pagination-controls">
                    <c:choose>
                        <c:when test="${currentPage > 1}">
                            <c:url var="rvPrevUrl" value="/app/reviews">
                                <c:param name="tab" value="ideas"/><c:param name="ideaView" value="${ideaView}"/><c:param name="q" value="${q}"/>
                                <c:param name="dateFrom" value="${dateFrom}"/><c:param name="dateTo" value="${dateTo}"/>
                                <c:param name="sort" value="${sort}"/><c:param name="pageSize" value="${pageSize}"/>
                                <c:param name="page" value="${currentPage - 1}"/>
                            </c:url>
                            <a href="${rvPrevUrl}">&#8249;</a>
                        </c:when>
                        <c:otherwise><span class="page-disabled">&#8249;</span></c:otherwise>
                    </c:choose>
                    <c:forEach begin="1" end="${totalPages}" var="p">
                        <c:choose>
                            <c:when test="${p == currentPage}"><span class="page-current">${p}</span></c:when>
                            <c:otherwise>
                                <c:url var="rvPageUrl" value="/app/reviews">
                                    <c:param name="tab" value="ideas"/><c:param name="ideaView" value="${ideaView}"/><c:param name="q" value="${q}"/>
                                    <c:param name="dateFrom" value="${dateFrom}"/><c:param name="dateTo" value="${dateTo}"/>
                                    <c:param name="sort" value="${sort}"/><c:param name="pageSize" value="${pageSize}"/>
                                    <c:param name="page" value="${p}"/>
                                </c:url>
                                <a href="${rvPageUrl}">${p}</a>
                            </c:otherwise>
                        </c:choose>
                    </c:forEach>
                    <c:choose>
                        <c:when test="${currentPage < totalPages}">
                            <c:url var="rvNextUrl" value="/app/reviews">
                                <c:param name="tab" value="ideas"/><c:param name="ideaView" value="${ideaView}"/><c:param name="q" value="${q}"/>
                                <c:param name="dateFrom" value="${dateFrom}"/><c:param name="dateTo" value="${dateTo}"/>
                                <c:param name="sort" value="${sort}"/><c:param name="pageSize" value="${pageSize}"/>
                                <c:param name="page" value="${currentPage + 1}"/>
                            </c:url>
                            <a href="${rvNextUrl}">&#8250;</a>
                        </c:when>
                        <c:otherwise><span class="page-disabled">&#8250;</span></c:otherwise>
                    </c:choose>
                </div>
            </div>
        </div>
    </div>

    <div class="reviews-detail">
        <c:choose>
            <c:when test="${empty selectedIdea}">
                <div class="panel reviews-detail-empty">
                    <p class="muted">No idea selected. Choose a row from the queue to review it.</p>
                </div>
            </c:when>
            <c:otherwise>
                <c:set var="rvIdeaLastUpdated" value="${empty ideaStatusHistory ? selectedIdea.submittedAt : ideaStatusHistory[0].timestamp}"/>
                <div class="panel reviews-detail-card" id="reviewsDetailCard" data-review-type="idea" data-review-id="${selectedIdea.id}">
                    <div class="reviews-detail-head">
                        <h2 class="reviews-detail-title">${ideaView == 'retained' ? 'Retained Idea' : 'Reviewing Idea'}</h2>
                        <span class="status-pill ${ideaStatusCssClass}"><c:out value="${ideaStatusLabel}"/></span>
                    </div>
                    <div class="reviews-detail-id-row"><c:out value="${selectedIdea.businessIdeaCode}"/></div>

                    <%-- Single-column inline list (not the shared .reviews-detail-fields-grid 2-column
                         layout reviews-shoot.jspf/reviews-edit.jspf still use unchanged) - every field
                         is its own plain .reviews-field-row, label and value on the same line,
                         stacked top to bottom. --%>
                    <div class="reviews-detail-section reviews-detail-section-list">
                        <div class="reviews-field-row">
                            <span class="reviews-field-label">Title</span>
                            <span class="reviews-field-value"><c:out value="${selectedIdea.title}"/></span>
                        </div>
                        <div class="reviews-field-row">
                            <span class="reviews-field-label">Reference Link</span>
                            <span class="reviews-field-value">
                                <c:choose>
                                    <c:when test="${not empty selectedIdea.referenceLink}">
                                        <a href="${fn:escapeXml(selectedIdea.referenceLink)}" target="_blank" rel="noopener noreferrer"><c:out value="${selectedIdea.referenceLink}"/></a>
                                    </c:when>
                                    <c:otherwise><span class="muted">-</span></c:otherwise>
                                </c:choose>
                            </span>
                        </div>
                        <%-- ENG: the note icon now shows ALWAYS (ideaDescModalAlwaysShow), not only when a
                             description exists - clicking it opens a read-only modal with the complete
                             text, or "No description added yet." for an empty one (view-only for most
                             users; CEO/Marketing Manager also get an Edit control - see
                             fragments/idea-description-modal*.jspf and IdeaService#updateDescription).
                             The inline value itself stays a short preview (never the raw unlimited-length
                             text - see idea-description-modal.jspf's own header comment for why), full
                             text lives in the modal. Re-wired after every AJAX swap by
                             reviews-workspace.js since this whole panel's innerHTML is replaced on each
                             selection. --%>
                        <c:set var="ideaDescModalIdea" value="${selectedIdea}"/>
                        <c:set var="ideaDescModalCanEdit" value="${canEditIdeaDescription}"/>
                        <c:set var="ideaDescModalAjax" value="${true}"/>
                        <c:set var="ideaDescModalAlwaysShow" value="${true}"/>
                        <c:set var="ideaDescModalTriggerClass" value=""/>
                        <div class="reviews-field-row">
                            <span class="reviews-field-label">Description / Details</span>
                            <span class="reviews-field-value reviews-field-value-with-icon">
                                <c:choose>
                                    <c:when test="${not empty selectedIdea.notesRemarks}">
                                        <c:choose>
                                            <c:when test="${fn:length(selectedIdea.notesRemarks) > 100}"><c:out value="${fn:substring(selectedIdea.notesRemarks, 0, 100)}"/>&hellip;</c:when>
                                            <c:otherwise><c:out value="${selectedIdea.notesRemarks}"/></c:otherwise>
                                        </c:choose>
                                    </c:when>
                                    <c:otherwise><span class="muted">-</span></c:otherwise>
                                </c:choose>
                                <%@ include file="idea-description-modal-trigger.jspf" %>
                            </span>
                        </div>
                        <%@ include file="idea-description-modal.jspf" %>
                        <div class="reviews-field-row">
                            <span class="reviews-field-label">Additional Note</span>
                            <span class="reviews-field-value">
                                <c:choose>
                                    <c:when test="${not empty selectedIdea.additionalNote}"><c:out value="${selectedIdea.additionalNote}"/></c:when>
                                    <c:otherwise><span class="muted">-</span></c:otherwise>
                                </c:choose>
                            </span>
                        </div>
                        <div class="reviews-field-row">
                            <span class="reviews-field-label">Submitted By</span>
                            <span class="reviews-field-value"><c:out value="${selectedIdea.submittedBy.fullName}"/></span>
                        </div>
                        <div class="reviews-field-row">
                            <span class="reviews-field-label">Submitted On</span>
                            <span class="reviews-field-value">${kcpc:ist(selectedIdea.submittedAt)}</span>
                        </div>
                        <div class="reviews-field-row">
                            <span class="reviews-field-label">Last Updated</span>
                            <span class="reviews-field-value">${kcpc:ist(rvIdeaLastUpdated)}</span>
                        </div>
                    </div>

                    <div class="reviews-detail-section">
                        <h3 class="reviews-detail-subhead">Idea Decision History</h3>
                        <ul class="reviews-history-list">
                            <c:forEach var="event" items="${ideaStatusHistory}">
                                <li>
                                    <span class="idea-action-badge idea-action-badge-${fn:toLowerCase(event.eventLabel)}"><c:out value="${event.eventLabel}"/></span>
                                    <span class="reviews-history-meta">${kcpc:ist(event.timestamp)} &middot; <c:out value="${event.triggeredByName}"/></span>
                                    <c:if test="${not empty event.reason}"><p class="reviews-history-reason"><c:out value="${event.reason}"/></p></c:if>
                                </li>
                            </c:forEach>
                            <c:if test="${empty ideaStatusHistory}"><li class="muted">No history yet.</li></c:if>
                        </ul>
                    </div>

                    <c:choose>
                        <c:when test="${ideaView == 'retained'}">
                            <c:choose>
                                <c:when test="${canDecideSelected}">
                                    <div class="reviews-detail-section reviews-decision-section">
                                        <h3 class="reviews-detail-subhead">Reopen This Idea</h3>
                                        <p class="muted">Reopening sends this idea back to Pending Approval for a fresh review decision.</p>
                                        <div class="reviews-decision-buttons">
                                            <button type="button" class="reviews-idea-reopen-btn" id="reviewsIdeaReopenBtn">&#8635; Reopen</button>
                                        </div>
                                        <div class="reviews-decision-error hidden" id="reviewsDecisionError"></div>
                                    </div>
                                </c:when>
                                <c:otherwise>
                                    <p class="note-box">You do not hold Idea Review permission to reopen this idea.</p>
                                </c:otherwise>
                            </c:choose>
                        </c:when>
                        <c:when test="${canDecideSelected}">
                            <div class="reviews-detail-section reviews-decision-section">
                                <h3 class="reviews-detail-subhead">Idea Decision</h3>
                                <div class="reviews-decision-buttons">
                                    <button type="button" class="reviews-decision-btn reviews-decision-approve" data-decision="APPROVE">&#10003; Approve</button>
                                    <button type="button" class="reviews-decision-btn reviews-decision-reject" data-decision="REJECT">&#10007; Reject</button>
                                    <button type="button" class="reviews-decision-btn reviews-decision-retain" data-decision="RETAIN">&#9998; Retain</button>
                                </div>

                                <div class="reviews-approve-banner hidden" id="reviewsIdeaApproveBanner">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><line x1="12" y1="8" x2="12" y2="8.01"/><line x1="12" y1="11" x2="12" y2="16"/></svg>
                                    <span>Approving will save planning details, assign initial shoot team and move the idea to Shoot Assigned stage.</span>
                                </div>

                                <%-- Reject/Retain: reason only, no planning fields. --%>
                                <div class="hidden" id="reviewsIdeaReasonBlock">
                                    <label id="reviewsIdeaReasonLabel" for="reviewsIdeaReason">Decision Reason (mandatory for Reject; optional for Retain)</label>
                                    <textarea id="reviewsIdeaReason" rows="3" maxlength="500" placeholder="Provide a reason for your decision..."></textarea>
                                    <div class="idea-detail-reason-counter-row">
                                        <span class="char-counter" data-counter-for="reviewsIdeaReason">0 / 500</span>
                                    </div>
                                </div>
                            </div>
                        </c:when>
                        <c:otherwise>
                            <p class="note-box">You cannot make a review decision on this idea &mdash; either it is
                                routed to another authorized reviewer, or you do not hold Idea Review permission.</p>
                        </c:otherwise>
                    </c:choose>
                </div>
            </c:otherwise>
        </c:choose>
    </div>
</div>

<%-- Planning Details is a dedicated full-width section below the queue/review-panel row, not
     squeezed into the narrow right column - the Review Decision panel above stays exactly as-is
     (info, history, Approve/Reject/Retain buttons, banner, Reason field for Reject/Retain); only the
     Approve-only Planning form (and its confirm bar, which must stay visually AFTER the form the
     user is confirming) lives here. Repeats the same selectedIdea/ideaView/canDecideSelected gating
     the narrow panel's own c:choose above already used, since this section is a sibling of
     .reviews-body rather than nested inside it. --%>
<c:if test="${not empty selectedIdea and ideaView != 'retained' and canDecideSelected}">
    <div class="reviews-planning-fullwidth">
                                <%-- Approve: the complete merged Planning Details form, only relevant/shown for Approve -
                                     same fields/model attributes idea-detail.jsp's Planning Details block already uses
                                     (see ReviewsMvcController#buildIdeasTab), reorganized into the numbered cards below. --%>
                                <div class="hidden" id="reviewsIdeaPlanningFields">
                                    <div class="panel reviews-planning-card">
                                        <h3 class="reviews-section-heading"><span class="reviews-section-number">1</span> Planning Basics</h3>
                                        <div class="form-grid">
                                            <label>Priority *
                                                <select id="reviewsIdeaContentPriority" required>
                                                    <option value="" selected disabled>Select priority</option>
                                                    <c:forEach var="p" items="${priorities}">
                                                        <option value="${p}">${p}</option>
                                                    </c:forEach>
                                                </select>
                                            </label>
                                            <label>SKU Reference <input type="text" id="reviewsIdeaSkuReference"></label>
                                            <label>Planning Mode *
                                                <select id="reviewsIdeaPlanningMode">
                                                    <option value="STANDARD" selected>Standard</option>
                                                    <option value="URGENT">Urgent</option>
                                                </select>
                                            </label>
                                            <label>Category (optional) <input type="text" id="reviewsIdeaCategoryText"></label>
                                            <label>Asset Folder / Drive Link
                                                <span class="reviews-drive-input">
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
                                                    <input type="text" id="reviewsIdeaFolderLink" placeholder="https://drive.google.com/...">
                                                </span>
                                            </label>
                                        </div>
                                    </div>

                                    <div class="panel reviews-planning-card">
                                        <h3 class="reviews-section-heading"><span class="reviews-section-number">2</span> Schedule</h3>
                                        <div class="form-grid">
                                            <label>Planned Live Date * <input type="date" id="reviewsIdeaPlannedLiveDate" min="${today}"></label>
                                            <label id="reviewsIdeaShootDateLabel">Shoot Date * <input type="date" id="reviewsIdeaShootDate" min="${today}">
                                                <span class="reviews-schedule-hint" id="reviewsIdeaShootDateHint">Standard: Live Date &minus; 5 days</span></label>
                                            <label id="reviewsIdeaEditDateLabel">Edit Date * <input type="date" id="reviewsIdeaEditDate" min="${today}">
                                                <span class="reviews-schedule-hint" id="reviewsIdeaEditDateHint">Standard: Live Date &minus; 2 days</span></label>
                                            <label class="grid-span-all hidden" id="reviewsIdeaUrgencyReasonLabel">Urgency Reason (required for Urgent)
                                                <input type="text" id="reviewsIdeaUrgencyReason"></label>
                                        </div>
                                    </div>

                                    <div class="panel reviews-planning-card">
                                        <h3 class="reviews-section-heading"><span class="reviews-section-number">3</span> Planned Outputs</h3>
                                        <p class="reviews-field-hint">Select the type(s) of content you are planning to create and where they will be published.</p>

                                        <div class="reviews-outputs-grid-wrap">
                                            <table class="data-table reviews-outputs-grid">
                                                <thead>
                                                    <tr>
                                                        <th>Output Type</th>
                                                        <th>Platform / Channel</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <c:forEach var="t" items="${outputTypes}">
                                                        <tr class="reviews-output-row reviews-output-row-disabled" data-output-type="${t}">
                                                            <td class="reviews-output-type-cell">
                                                                <label class="reviews-output-type-toggle">
                                                                    <input type="checkbox" class="reviews-output-row-enable">
                                                                    <c:choose>
                                                                        <c:when test="${t == 'STORY'}">
                                                                            <span class="reviews-output-type-icon reviews-output-type-icon-STORY">
                                                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4"/></svg>
                                                                            </span>
                                                                            <span class="reviews-output-type-copy">
                                                                                <strong>Story</strong>
                                                                                <span class="muted">Short vertical stories for engagement</span>
                                                                            </span>
                                                                        </c:when>
                                                                        <c:when test="${t == 'POST'}">
                                                                            <span class="reviews-output-type-icon reviews-output-type-icon-POST">
                                                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                                                                            </span>
                                                                            <span class="reviews-output-type-copy">
                                                                                <strong>Post</strong>
                                                                                <span class="muted">Images / graphics / carousels for feeds</span>
                                                                            </span>
                                                                        </c:when>
                                                                        <c:when test="${t == 'REEL'}">
                                                                            <span class="reviews-output-type-icon reviews-output-type-icon-REEL">
                                                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18"/><line x1="7" y1="2" x2="7" y2="22"/><line x1="17" y1="2" x2="17" y2="22"/><line x1="2" y1="12" x2="22" y2="12"/><line x1="2" y1="7" x2="7" y2="7"/><line x1="2" y1="17" x2="7" y2="17"/><line x1="17" y1="17" x2="22" y2="17"/><line x1="17" y1="7" x2="22" y2="7"/></svg>
                                                                            </span>
                                                                            <span class="reviews-output-type-copy">
                                                                                <strong>Reel</strong>
                                                                                <span class="muted">Short vertical videos for social platforms</span>
                                                                            </span>
                                                                        </c:when>
                                                                        <c:otherwise>
                                                                            <span class="reviews-output-type-icon reviews-output-type-icon-LONG_VIDEO">
                                                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>
                                                                            </span>
                                                                            <span class="reviews-output-type-copy">
                                                                                <strong>Long Video</strong>
                                                                                <span class="muted">Long-form or horizontal videos</span>
                                                                            </span>
                                                                        </c:otherwise>
                                                                    </c:choose>
                                                                </label>
                                                            </td>
                                                            <td class="reviews-output-platform-cell">
                                                                <details class="reviews-platform-picker">
                                                                    <summary class="reviews-platform-picker-toggle">
                                                                        <span class="reviews-platform-chips"><span class="muted">Select platforms</span></span>
                                                                        <span class="reviews-platform-picker-count muted">0 selected</span>
                                                                    </summary>
                                                                    <div class="kcpc-channel-checklist reviews-output-target-checklist">
                                                                        <c:forEach var="pt" items="${activePublicationTargets}">
                                                                            <label class="channel-check-item" data-platform="${pt.platform.platformName}">
                                                                                <input type="checkbox" class="reviews-output-target-checkbox" value="${pt.id}"
                                                                                       data-platform="${pt.platform.platformName}"
                                                                                       data-channel="${pt.channel.channelHandle}"> ${pt.platform.platformName} / ${pt.channel.channelHandle}
                                                                            </label>
                                                                        </c:forEach>
                                                                    </div>
                                                                </details>
                                                                <div class="reviews-output-platform-popovers"></div>
                                                            </td>
                                                        </tr>
                                                    </c:forEach>
                                                </tbody>
                                            </table>
                                        </div>
                                        <div class="reviews-decision-error hidden" id="reviewsIdeaOutputError"></div>
                                    </div>

                                    <div class="panel reviews-planning-card">
                                        <h3 class="reviews-section-heading"><span class="reviews-section-number">4</span> Initial Shoot Assignment</h3>
                                        <%-- 3-column row: Cameraperson(s) / Shoot Lead / Model(s)/Talent, one CSS grid
                                             row, all three columns using the SAME label+control wrapper structure
                                             (.reviews-shoot-assignment-col) so they align to the exact same top edge -
                                             no per-field row-spanning/positioning tricks that could drift out of sync.
                                             Shoot Lead's <select> must still stay a DOM descendant of the Cameraperson
                                             .kcpc-model-picker (model-picker.js's refreshLeadOptions finds it via
                                             picker.querySelector('.kcpc-lead-select'), scoped to that one picker
                                             instance) - .reviews-shoot-assignment-camera is display:contents so its
                                             two .reviews-shoot-assignment-col children (Cameraperson's own column,
                                             Shoot Lead's own column) become the actual grid items while the Lead
                                             select stays nested inside the Cameraperson picker. Model(s)/Talent is its
                                             own separate, independently-wired .kcpc-model-picker carrying the same
                                             .reviews-shoot-assignment-col class directly (a true sibling, not nested) -
                                             optional, no * in the label; empty selection is already accepted by
                                             IdeaService#approve, which only iterates planning.talentUserIds() when
                                             non-null - unchanged. --%>
                                        <div class="reviews-shoot-assignment-grid">
                                            <div class="kcpc-model-picker reviews-shoot-assignment-camera">
                                                <div class="reviews-shoot-assignment-col">
                                                    <label>Cameraperson(s) *</label>
                                                    <div class="kcpc-model-input">
                                                        <div class="kcpc-model-chips"></div>
                                                        <input type="text" class="kcpc-model-search" placeholder="Search cameraperson...">
                                                    </div>
                                                    <div class="kcpc-model-checklist">
                                                        <c:forEach var="cu" items="${camerapersonUsers}">
                                                            <label class="model-check-item">
                                                                <input type="checkbox" name="camerapersonUserIds" value="${cu.id}" data-name="${cu.fullName}"> ${cu.fullName}
                                                                <span class="muted assignee-task-count">(<c:out value="${cu.activeTaskLabel}"/>)</span>
                                                            </label>
                                                        </c:forEach>
                                                    </div>
                                                </div>
                                                <div class="reviews-shoot-assignment-col">
                                                    <label for="reviewsIdeaLeadCameraperson">Shoot Lead *</label>
                                                    <select id="reviewsIdeaLeadCameraperson" class="kcpc-lead-select" disabled>
                                                        <option value="">- None -</option>
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="kcpc-model-picker reviews-shoot-assignment-col">
                                                <label>Model(s) / Talent</label>
                                                <div class="kcpc-model-input">
                                                    <div class="kcpc-model-chips"></div>
                                                    <input type="text" class="kcpc-model-search" placeholder="Search model...">
                                                </div>
                                                <div class="kcpc-model-checklist">
                                                    <c:forEach var="mu" items="${modelUsers}">
                                                        <label class="model-check-item">
                                                            <input type="checkbox" name="modelUserIds" value="${mu.id}" data-name="${mu.fullName}"> ${mu.fullName}
                                                            <span class="muted assignee-task-count">(<c:out value="${mu.activeTaskLabel}"/>)</span>
                                                        </label>
                                                    </c:forEach>
                                                </div>
                                            </div>
                                            <p class="reviews-field-hint">Shoot Lead must be one of the selected Cameraperson(s).</p>
                                        </div>
                                    </div>

                                    <div class="panel reviews-planning-card">
                                        <h3 class="reviews-section-heading"><span class="reviews-section-number">5</span> Team Marks (Approve Only)</h3>
                                        <div class="form-grid">
                                            <label>Cameraperson Mark *
                                                <select id="reviewsIdeaCameramanMark">
                                                    <option value="0.0">0</option><option value="0.5">0.5</option>
                                                    <option value="1.0">1.0</option><option value="2.0">2.0</option><option value="3.0">3.0</option>
                                                </select>
                                            </label>
                                            <label>Editor Mark *
                                                <select id="reviewsIdeaEditorMark">
                                                    <option value="0.0">0</option><option value="0.5">0.5</option>
                                                    <option value="1.0">1.0</option><option value="2.0">2.0</option><option value="3.0">3.0</option>
                                                </select>
                                            </label>
                                            <label>Model Mark *
                                                <select id="reviewsIdeaModelMark">
                                                    <option value="0.0">0</option><option value="0.5">0.5</option>
                                                    <option value="1.0">1.0</option><option value="2.0">2.0</option><option value="3.0">3.0</option>
                                                </select>
                                            </label>
                                        </div>
                                    </div>
                                </div>

        <div class="reviews-decision-error hidden" id="reviewsDecisionError"></div>

        <%-- Bottom confirm bar: the actual submit action for all three decisions - primary
             label/text driven by JS per the decision currently selected above. Lives here (after
             the wide Planning form) rather than in the narrow panel above, so Approve's confirm
             click always comes after the form the reviewer just filled in. --%>
        <div class="reviews-decision-confirm-bar hidden" id="reviewsIdeaConfirmBar">
            <button type="button" class="btn-outline" id="reviewsIdeaCancelBtn">Cancel</button>
            <button type="button" class="reviews-decision-confirm-btn" id="reviewsIdeaConfirmBtn">Approve &amp; Assign Shoot</button>
        </div>
    </div>
</c:if>
