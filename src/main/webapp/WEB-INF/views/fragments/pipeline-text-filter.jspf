<%-- ENG-071: one text-substring filter column header (SKU/Idea/Cameraperson/Model/Video Editor) -
     included once per column instead of repeating this block by hand. Caller sets via <c:set>
     immediately before including:
       filterField      - query param name (e.g. "sku")
       filterLabel      - visible header text
       filterValue      - this field's current value (may be empty)
       filterActive     - true if this column currently has a filter applied (highlights the icon)
       filterSortField  - sortBy value if this column is ALSO sortable, or "" if sort-less
     All filter inputs live inside the ONE shared form wrapping the whole table
     (#pipelineFilterForm in pipeline.jsp), so "Apply" here submits every other column's current
     filter value too, not just this one. --%>
<div class="pipeline-th-flex">
    <c:choose>
        <c:when test="${not empty filterSortField}">
            <c:set var="sortField" value="${filterSortField}"/><c:set var="sortLabel" value="${filterLabel}"/>
            <%@ include file="pipeline-sort-header.jspf" %>
        </c:when>
        <c:otherwise><span class="pipeline-th-label"><c:out value="${filterLabel}"/></span></c:otherwise>
    </c:choose>
    <button type="button" class="pipeline-filter-trigger ${filterActive ? 'active' : ''}" data-popup-target="popup-${filterField}" aria-label="Filter ${filterLabel}">&#9660;</button>
</div>
<div class="pipeline-filter-popup hidden" id="popup-${filterField}">
    <label>${filterLabel}
        <input type="text" name="${filterField}" value="${fn:escapeXml(filterValue)}" placeholder="Contains...">
    </label>
    <div class="pipeline-filter-popup-actions">
        <button type="button" class="btn-outline pipeline-filter-clear">Clear</button>
        <button type="submit" class="btn-outline">Apply</button>
    </div>
</div>
