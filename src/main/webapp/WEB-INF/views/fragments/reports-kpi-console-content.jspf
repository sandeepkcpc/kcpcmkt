<%-- KPI Dashboard shell (Reports -> KPI Dashboard): page header, the common date-range filter
     (applies across every KPI view), the 5-view sub-nav (Overview/Workflow & SLA/Content &
     Publishing/Quality & Reviews/Performance, each a real server-rendered ?view= link - not
     client-only JS state, so Refresh/Back/Forward/deep-links all work), and the ${kpiView}-specific
     content include. Caller (ReportingMvcController#kpiDashboard) sets ${kpiView} (one of
     overview/workflow/content/quality/performance, already validated/defaulted server-side),
     ${selectedDateFrom}/${selectedDateTo}, ${reportsDataAsOf}, and exactly one of
     ${overview}/${workflowSla}/${contentPublishing}/${qualityReviews}/${performanceDashboard}
     matching ${kpiView}. --%>
<div class="page-header-row">
    <div>
        <h1>Marketing KPI Dashboard</h1>
        <p class="muted">Real-time overview of marketing content operations and performance</p>
    </div>
    <%@ include file="reports-asof-badge.jspf" %>
</div>

<%-- The SAME date range applies to every KPI view (spec requirement) - the hidden view field
     carries the currently-active view forward whenever this form is submitted, and each view-tab
     link below carries the current date range forward too, so switching either dimension never
     resets the other. --%>
<form method="get" action="${pageContext.request.contextPath}/app/reports/kpis" class="reports-filters kpi-date-toolbar" id="reportsKpiFilterForm">
    <input type="hidden" name="view" value="${kpiView}">
    <div class="filter-field kpi-date-field">
        <label for="kpiDateFrom">Date Range</label>
        <div class="filter-date-range">
            <input type="date" name="startDate" id="kpiDateFrom" value="${selectedDateFrom}">
            <span class="filter-date-sep">&ndash;</span>
            <input type="date" name="endDate" id="kpiDateTo" value="${selectedDateTo}">
        </div>
    </div>
</form>

<div class="kpi-view-tabs">
    <a class="kpi-view-tab ${kpiView == 'overview' ? 'active' : ''}"
       href="${pageContext.request.contextPath}/app/reports/kpis?view=overview&startDate=${selectedDateFrom}&endDate=${selectedDateTo}">Overview</a>
    <a class="kpi-view-tab ${kpiView == 'workflow' ? 'active' : ''}"
       href="${pageContext.request.contextPath}/app/reports/kpis?view=workflow&startDate=${selectedDateFrom}&endDate=${selectedDateTo}">Workflow &amp; SLA</a>
    <a class="kpi-view-tab ${kpiView == 'content' ? 'active' : ''}"
       href="${pageContext.request.contextPath}/app/reports/kpis?view=content&startDate=${selectedDateFrom}&endDate=${selectedDateTo}">Content &amp; Publishing</a>
    <a class="kpi-view-tab ${kpiView == 'quality' ? 'active' : ''}"
       href="${pageContext.request.contextPath}/app/reports/kpis?view=quality&startDate=${selectedDateFrom}&endDate=${selectedDateTo}">Quality &amp; Reviews</a>
    <a class="kpi-view-tab ${kpiView == 'performance' ? 'active' : ''}"
       href="${pageContext.request.contextPath}/app/reports/kpis?view=performance&startDate=${selectedDateFrom}&endDate=${selectedDateTo}">Performance</a>
</div>

<c:choose>
    <c:when test="${kpiView == 'workflow'}"><%@ include file="reports-kpi-workflow.jspf" %></c:when>
    <c:when test="${kpiView == 'content'}"><%@ include file="reports-kpi-content.jspf" %></c:when>
    <c:when test="${kpiView == 'quality'}"><%@ include file="reports-kpi-quality.jspf" %></c:when>
    <c:when test="${kpiView == 'performance'}"><%@ include file="reports-kpi-performance.jspf" %></c:when>
    <c:otherwise><%@ include file="reports-kpi-overview.jspf" %></c:otherwise>
</c:choose>

<p class="note-box kpi-dashboard-footnote">Metrics are calculated based on current targets, workflow states, and user
    contributions. Reopened cycles without fresh targets are excluded from SLA denominators until targets are defined.</p>
