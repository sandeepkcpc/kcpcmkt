<%-- CEO/MM Reports - Administrative Actions tab. Caller sets ${rows} (List<AdminActionRow>),
     ${performers} (Set<String>), ${selectedActionType}/${selectedPerformedBy}/${q}/
     ${selectedDateFrom}/${selectedDateTo}, pagination attrs, ${reportsDataAsOf}. Read-only summary
     - no edit/delete controls anywhere on this screen (spec requirement); every row is sourced
     directly from the immutable system_audit_log. --%>
<div class="page-header-row">
    <div>
        <h1>Administrative Actions</h1>
        <p class="muted">Read-only management summary of governed administrative actions.</p>
    </div>
    <%@ include file="reports-asof-badge.jspf" %>
</div>

<form method="get" action="${pageContext.request.contextPath}/app/reports/admin-actions" class="reports-filters" id="reportsAdminActionsFilterForm">
    <div class="filter-field">
        <label for="aaActionType">Action</label>
        <select name="actionType" id="aaActionType">
            <option value="" ${empty selectedActionType ? 'selected' : ''}>All Actions</option>
            <option value="REASSIGN" ${selectedActionType == 'REASSIGN' ? 'selected' : ''}>Reassigned</option>
            <option value="RESCHEDULE" ${selectedActionType == 'RESCHEDULE' ? 'selected' : ''}>Rescheduled</option>
            <option value="HOLD" ${selectedActionType == 'HOLD' ? 'selected' : ''}>Hold</option>
            <option value="RESUME" ${selectedActionType == 'RESUME' ? 'selected' : ''}>Resume</option>
            <option value="CANCEL" ${selectedActionType == 'CANCEL' ? 'selected' : ''}>Cancelled</option>
            <option value="REOPEN" ${selectedActionType == 'REOPEN' ? 'selected' : ''}>Reopened</option>
            <option value="IDEA_RETAINED" ${selectedActionType == 'IDEA_RETAINED' ? 'selected' : ''}>Idea Retained</option>
            <option value="PERMISSION_GRANT" ${selectedActionType == 'PERMISSION_GRANT' ? 'selected' : ''}>Permission Granted</option>
            <option value="PERMISSION_REVOKE" ${selectedActionType == 'PERMISSION_REVOKE' ? 'selected' : ''}>Permission Revoked</option>
        </select>
    </div>
    <div class="filter-field">
        <label for="aaPerformedBy">Performed By</label>
        <select name="performedBy" id="aaPerformedBy">
            <option value="">All</option>
            <c:forEach var="p" items="${performers}">
                <option value="${fn:escapeXml(p)}" ${selectedPerformedBy == p ? 'selected' : ''}><c:out value="${p}"/></option>
            </c:forEach>
        </select>
    </div>
    <div class="filter-field filter-field-search">
        <label for="aaSearch">Content / User</label>
        <input type="text" name="q" id="aaSearch" placeholder="Search content or user..." value="${fn:escapeXml(q)}">
    </div>
    <div class="filter-field">
        <label for="aaDateFrom">Date Range</label>
        <div class="filter-date-range">
            <input type="date" name="startDate" id="aaDateFrom" value="${selectedDateFrom}">
            <span class="filter-date-sep">&ndash;</span>
            <input type="date" name="endDate" id="aaDateTo" value="${selectedDateTo}">
        </div>
    </div>
    <a class="btn-outline reports-clear" href="${pageContext.request.contextPath}/app/reports/admin-actions">
        <span aria-hidden="true">&#8635;</span> Clear
    </a>
</form>

<div class="panel reports-table-panel">
    <div class="reports-table-scroll">
    <table class="data-table reports-table">
        <thead>
        <tr><th>Action</th><th>Content / User</th><th>Performed By</th><th>Date &amp; Time</th><th>Reason</th></tr>
        </thead>
        <tbody>
        <c:forEach var="r" items="${rows}">
            <tr>
                <td><span class="admin-action-badge admin-action-${fn:toLowerCase(r.action)}"><c:out value="${r.action}"/></span></td>
                <td>
                    <c:choose>
                        <c:when test="${not empty r.contentPlanId}">
                            <a class="idea-id-link" href="${pageContext.request.contextPath}/app/deliverables/${r.contentPlanId}"><c:out value="${r.contentOrUserDisplay}"/></a>
                        </c:when>
                        <c:when test="${not empty r.contentOrUserDisplay}"><c:out value="${r.contentOrUserDisplay}"/></c:when>
                        <c:otherwise>-</c:otherwise>
                    </c:choose>
                </td>
                <td>
                    <div><c:out value="${r.performedByName}"/></div>
                    <div class="reports-meta-subtext"><c:out value="${r.performedByRole}"/></div>
                </td>
                <td>${kcpc:ist(r.timestamp)}</td>
                <td class="reports-reason-cell"><c:out value="${empty r.reason ? '-' : r.reason}"/></td>
            </tr>
        </c:forEach>
        <c:if test="${empty rows}">
            <tr><td colspan="5" class="muted">No administrative actions match the current filters.</td></tr>
        </c:if>
        </tbody>
    </table>
    </div>

    <div class="pagination reports-pagination">
        <span>Showing ${fromIndex} to ${toIndex} of ${totalCount}</span>
        <div class="reports-page-size">
            <select id="aaPageSize" name="pageSize" form="reportsAdminActionsFilterForm">
                <option value="10" ${pageSize == 10 ? 'selected' : ''}>10 per page</option>
                <option value="25" ${pageSize == 25 ? 'selected' : ''}>25 per page</option>
                <option value="50" ${pageSize == 50 ? 'selected' : ''}>50 per page</option>
            </select>
        </div>
        <div class="pagination-controls">
            <c:choose>
                <c:when test="${currentPage > 1}">
                    <c:url var="aaPrevUrl" value="/app/reports/admin-actions">
                        <c:param name="actionType" value="${selectedActionType}"/><c:param name="performedBy" value="${selectedPerformedBy}"/>
                        <c:param name="q" value="${q}"/><c:param name="startDate" value="${selectedDateFrom}"/><c:param name="endDate" value="${selectedDateTo}"/>
                        <c:param name="pageSize" value="${pageSize}"/><c:param name="page" value="${currentPage - 1}"/>
                    </c:url>
                    <a href="${aaPrevUrl}">&#8249;</a>
                </c:when>
                <c:otherwise><span class="page-disabled">&#8249;</span></c:otherwise>
            </c:choose>
            <c:forEach begin="1" end="${totalPages}" var="p">
                <c:choose>
                    <c:when test="${p == currentPage}"><span class="page-current">${p}</span></c:when>
                    <c:otherwise>
                        <c:url var="aaPageUrl" value="/app/reports/admin-actions">
                            <c:param name="actionType" value="${selectedActionType}"/><c:param name="performedBy" value="${selectedPerformedBy}"/>
                            <c:param name="q" value="${q}"/><c:param name="startDate" value="${selectedDateFrom}"/><c:param name="endDate" value="${selectedDateTo}"/>
                            <c:param name="pageSize" value="${pageSize}"/><c:param name="page" value="${p}"/>
                        </c:url>
                        <a href="${aaPageUrl}">${p}</a>
                    </c:otherwise>
                </c:choose>
            </c:forEach>
            <c:choose>
                <c:when test="${currentPage < totalPages}">
                    <c:url var="aaNextUrl" value="/app/reports/admin-actions">
                        <c:param name="actionType" value="${selectedActionType}"/><c:param name="performedBy" value="${selectedPerformedBy}"/>
                        <c:param name="q" value="${q}"/><c:param name="startDate" value="${selectedDateFrom}"/><c:param name="endDate" value="${selectedDateTo}"/>
                        <c:param name="pageSize" value="${pageSize}"/><c:param name="page" value="${currentPage + 1}"/>
                    </c:url>
                    <a href="${aaNextUrl}">&#8250;</a>
                </c:when>
                <c:otherwise><span class="page-disabled">&#8250;</span></c:otherwise>
            </c:choose>
        </div>
    </div>
</div>
