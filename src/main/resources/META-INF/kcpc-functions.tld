<?xml version="1.0" encoding="UTF-8"?>
<taglib xmlns="https://jakarta.ee/xml/ns/jakartaee"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-jsptaglibrary_3_0.xsd"
        version="3.0">
    <tlib-version>1.0</tlib-version>
    <short-name>kcpc</short-name>
    <uri>https://kcpc.internal/tags/functions</uri>

    <function>
        <description>SAD-ADR-003: format a UTC-stored Instant for IST (Asia/Kolkata) business display.</description>
        <name>ist</name>
        <function-class>com.kcpc.mkt.common.util.DisplayTime</function-class>
        <function-signature>java.lang.String ist(java.time.Instant)</function-signature>
    </function>

    <function>
        <description>ENG-061: date-only part of the IST display timestamp, for two-line date/time columns.</description>
        <name>istDate</name>
        <function-class>com.kcpc.mkt.common.util.DisplayTime</function-class>
        <function-signature>java.lang.String istDate(java.time.Instant)</function-signature>
    </function>

    <function>
        <description>ENG-061: 12-hour time-only part of the IST display timestamp, for two-line date/time columns.</description>
        <name>istTime</name>
        <function-class>com.kcpc.mkt.common.util.DisplayTime</function-class>
        <function-signature>java.lang.String istTime(java.time.Instant)</function-signature>
    </function>

    <function>
        <description>yyyy-MM-dd (IST date part) - the format an HTML input[type=date] needs for its
            value attribute to prefill correctly; istDate ("24 Aug 2026") is read-only display only.</description>
        <name>isoDate</name>
        <function-class>com.kcpc.mkt.common.util.DisplayTime</function-class>
        <function-signature>java.lang.String isoDate(java.time.Instant)</function-signature>
    </function>

    <function>
        <description>Missing-value display rule: "-" for null/blank, and also for a shared row DTO field
            that already bakes in an em-dash placeholder at the service layer.</description>
        <name>dash</name>
        <function-class>com.kcpc.mkt.common.util.DisplayText</function-class>
        <function-signature>java.lang.String dash(java.lang.String)</function-signature>
    </function>

    <function>
        <description>Duration display rule: "-" for null (no applicable data, never confused with a
            genuinely-zero measured duration), "1 day" singular at exactly 1, "0 days"/"2 days"/"3.4 days"
            otherwise - rounded to 1 decimal.</description>
        <name>days</name>
        <function-class>com.kcpc.mkt.common.util.DisplayNumber</function-class>
        <function-signature>java.lang.String days(java.lang.Number)</function-signature>
    </function>

    <function>
        <description>Averaged count metric display rule (e.g. Avg Impressions): thousands-separated
            whole number, "-" for null. Never used for percentage metrics (CTR keeps its own formatting).</description>
        <name>count</name>
        <function-class>com.kcpc.mkt.common.util.DisplayNumber</function-class>
        <function-signature>java.lang.String count(java.lang.Number)</function-signature>
    </function>
</taglib>
