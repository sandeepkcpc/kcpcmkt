# Copy this file to .env (or .env.local) and fill in real values.
# NEVER commit the copy - .env / .env.* / *.service-account.json are all gitignored already.
#
# Usage:
#   cp .env.example .env          # docker compose reads .env automatically
#   # or keep it as .env.local and run: docker compose --env-file .env.local up -d --build

# ---- Database (Postgres, provided by the "postgres" Compose service) ----------------------
# kcpc_migrator: schema-owning superuser, runs Flyway only. kcpc_app: restricted runtime role,
# every request-serving query. Pick your own strong values - these are never real credentials.
MIGRATOR_DB_PASSWORD=changeme-migrator-password
APP_DB_PASSWORD=changeme-app-password

# ---- Application security ------------------------------------------------------------------
# HS512 JWT signing secret, >=64 bytes. Generate one with: openssl rand -hex 64
APP_SECURITY_JWT_SECRET=changeme-generate-a-real-64-byte-secret-with-openssl-rand-hex-64

# Session/JWT cookie "Secure" flag. Leave false for this local Docker Compose stack (nginx here
# terminates plain HTTP, no local TLS cert). Set true only once this app sits behind real HTTPS.
COOKIE_SECURE=false

# ---- Google Drive folder provisioning (optional) -------------------------------------------
# Leave DRIVE_ENABLED=false (default) to leave the integration completely inert - the app starts
# and runs identically either way. Only fill the rest in if you have a real Google Workspace
# service account and target Shared Drive to provision folders into.
DRIVE_ENABLED=false

# Raw service-account JSON key content as ONE line (never a file path, never multi-line here).
# Flatten a downloaded key.json first, e.g.:
#   DRIVE_SERVICE_ACCOUNT_KEY=$(tr -d '\n' < key.json)          # or: jq -c . key.json
DRIVE_SERVICE_ACCOUNT_KEY=

# The Shared Drive folders are created on, and the KCPC root folder inside it that every
# Content ID's own root folder is created directly under.
DRIVE_SHARED_DRIVE_ID=
DRIVE_ROOT_FOLDER_ID=

# Optional: a Workspace user to impersonate via domain-wide delegation, only if the service
# account requires it. Leave blank if the service account has direct Shared Drive access.
DRIVE_IMPERSONATE_USER=
